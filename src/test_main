list<Point> PathPlanner::findPath() {
    cout << "finding path... " << endl;

    if (!g.isInGrid(start)) { cerr << "start point is not in grid." << endl; }
    if (!g.isInGrid(goal))  { cerr << "start point is not in grid." << endl; } 
 
    Node start_node;
    start_node.g = 0 ; 
    start_node.h = abs(start.x - goal.x) + abs(start.y - goal.y);
    start_node.f = start_node.g + start_node.h;

    list<Node> openSet;
    list<Node> closedSet;

    list<Point> path;
    openSet.push_back(start_node);
    Node bestNode = start_node;

    while (!openSet.empty()) 
    {   cout << "open set: " << openSet.size() << endl; 
        double min_cost = 1000;

        for (Node o : openSet) 
        {
            if (o.f < min_cost) 
            {
                min_cost = o.f;
                bestNode = o;
                closedSet.push_back(o); //closedSet_point.push_back(bestPoint);
            }  
        }

        openSet.remove(bestNode);
        cout << bestNode.position.x << ", " << bestNode.position.y << endl;
        
        list<Point> neighbors = g.findNeighbors(bestNode.position); 

        for (Point n : neighbors)
        {
            //if(closedSet_point(n))
            Node node;

            node.position.x = n.x;
            node.position.y = n.y;

            node.g++;
            node.h = abs(node.position.x - goal.x) + abs(node.position.y - goal.y);
            node.f = node.g + node.h;

            node.parent = bestNode.position;

            openSet.push_back(node);
        }
        
        if(bestNode.position == goal) { 
            //list<Point> reverse_path;
            
            while(bestNode.position != start) 
            {
                path.push_front(bestNode.parent);
                bestNode.position = bestNode.parent;
            }
            break;
            
        } 
    } 

    return path;
    cout << "path: ";
    for (Point p : path) {
        cout << p.x << "," << p.y << "\t";
    }
    cout << endl;
}





